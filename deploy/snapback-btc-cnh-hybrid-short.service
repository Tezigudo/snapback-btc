[Unit]
Description=snapback-btc cnh-hybrid-short-v1 leg (BTC/USDT perp, short-only)
After=network-online.target snapback-btc.service snapback-btc-donchian.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/snapback-btc
# `--instance cnh_short` makes the bot load /root/snapback-btc/.env.cnh_short
# (override=True) on top of the base .env. That file MUST hold the cnh_short
# sub-account's own BINANCE_API_KEY / BINANCE_API_SECRET, and ALSO:
#   CONSOLIDATE_SOURCE=snapback-btc-cnh-short   (else events collide with v1 on the dashboard)
#   ALERT_TAG=snapback-cnh-short                (else email subjects don't distinguish legs)
# The bot loads this file itself, so no systemd EnvironmentFile is used.
ExecStart=/root/snapback-btc/.venv/bin/python -m bot --instance cnh_short
# on-failure, NOT always: clean /halt and kill-switch flatten exit 0 and must stay down.
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=snapback-cnh-short

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/snapback-btc/data /root/snapback-btc/logs /root/snapback-btc/reports
# ProtectHome intentionally unset (deploy lives under /root).

[Install]
WantedBy=multi-user.target
