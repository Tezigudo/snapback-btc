# Copy to `.env` and fill in. Never commit `.env`.
# ──────────────────────────────────────────────────

# Environment: testnet | mainnet
# Mainnet ALSO requires `confirm_mainnet.lock` file at repo root.
BINANCE_ENV=testnet

# Binance Futures API keys.
# Testnet: https://testnet.binancefuture.com/en/futures/BTCUSDT  → API Key tab
# Mainnet: https://www.binance.com/en/my/settings/api-management  → restrict to Futures + IP-whitelist VPS
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Email alerts via SMTP (free with Gmail + app password).
#   1. Enable 2FA on the sending Google account.
#   2. Generate an app password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-char app password (no spaces) below as SMTP_PASSWORD.
# Any SMTP-capable provider works (Fastmail, Outlook, ProtonMail bridge, etc.) —
# just point SMTP_HOST/PORT/USER at it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Trading symbol (locked to BTC for v1)
SYMBOL=BTC/USDT:USDT

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
